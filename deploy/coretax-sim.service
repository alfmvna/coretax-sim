[Unit]
Description=Coretax Simulator (port 8140)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/coretax-sim
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8140
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
