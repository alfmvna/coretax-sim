# Konfigurasi Simulator Coretax DJP
# Copy: cp .env.example .env  lalu edit.
# .env TIDAK boleh masuk git (sudah ada di .gitignore).

# ------------------------------------------------------------ port & jaringan
# 127.0.0.1 = hanya server ini (paling aman; pakai reverse proxy)
# 0.0.0.0   = bisa diakses dari LAN
CORETAX_BIND=0.0.0.0
CORETAX_PORT=8140

# ------------------------------------------------------------------- mode
# demo   -> data demo dibuat otomatis (kelas/mahasiswa)
# strict -> tanpa data demo, hanya user yang dibuat manual
CORETAX_MODE=demo
CORETAX_SEED_DEMO=0

# --------------------------------------------------------------- keamanan
# Iterasi PBKDF2. Makin tinggi = makin lambat brute-force offline.
# 200000 ~ 100ms per hash di CPU modern. Jangan turunkan di produksi.
CORETAX_PBKDF2_ITER=200000

# Masa berlaku session (detik). 43200 = 12 jam
CORETAX_SESSION_TTL=43200

# Jumlah percobaan login gagal sebelum NPWP dikunci
CORETAX_MAX_ATTEMPT=5

# Durasi lockout (detik). 900 = 15 menit
CORETAX_LOCKOUT_SEC=900

# Batas percobaan per-IP dalam CORETAX_IP_WINDOW detik.
# Mencegah satu IP menyapu banyak NPWP berbeda.
CORETAX_IP_ATTEMPT_MAX=20
CORETAX_IP_WINDOW=300

# Masa berlaku token CSRF (detik). 28800 = 8 jam
CORETAX_CSRF_TTL=28800

# Set 1 kalau aplikasi diakses lewat HTTPS -> cookie dapat flag Secure
CORETAX_COOKIE_SECURE=0

# Set 1 HANYA kalau ada reverse proxy yang meneruskan X-Forwarded-For.
# Jangan set 1 kalau aplikasi langsung terekspos ( spoofing IP jadi mungkin).
CORETAX_TRUST_PROXY=0
